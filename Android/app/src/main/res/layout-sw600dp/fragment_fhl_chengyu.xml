<?xml version="1.0" encoding="utf-8"?>
<!-- 成语检索（平板双栏）：左＝检索条件，右＝检索结果
     v3.2：声调 / 拼音 / 单字三组同屏常显；平板两栏各有空间，不做折叠
     （layCondSummary 保留但永不显示，只是让 ViewBinding 在两种布局里字段一致）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:paddingStart="@dimen/fhl_screen_pad"
    android:paddingEnd="@dimen/fhl_screen_pad"
    android:paddingTop="@dimen/fhl_gap_s"
    android:paddingBottom="@dimen/fhl_gap_s">

    <!-- 左栏：条件 -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="42"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                android:id="@+id/header"
                layout="@layout/view_fhl_header" />

            <LinearLayout
                android:id="@+id/layCondSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_fhl_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/fhl_gap_m"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSummaryLabel"
                        style="@style/TextFhlCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/cy_cond_label" />

                    <TextView
                        android:id="@+id/tvCondSummary"
                        style="@style/TextFhlBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/fhl_gap_xs"
                        android:textColor="@color/fhl_ink" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSummaryToggle"
                    style="@style/TextFhlCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/fhl_gap_s"
                    android:text="@string/cy_cond_expand"
                    android:textColor="@color/fhl_vermilion" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/form"
                    layout="@layout/view_fhl_cy_form" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSearch"
                    style="@style/BtnFhlPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/fhl_btn_h_large"
                    android:layout_marginTop="@dimen/fhl_gap_m"
                    android:text="@string/cy_search" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="@dimen/fhl_stroke_hair"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/fhl_pane_gap"
        android:layout_marginEnd="@dimen/fhl_pane_gap"
        android:background="@color/fhl_line" />

    <!-- 右栏：结果（按钮行在结果标题上方） -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="58"
        android:orientation="vertical">

        <include
            android:id="@+id/actions"
            layout="@layout/view_fhl_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/fhl_gap_s" />

        <include
            android:id="@+id/result"
            layout="@layout/view_fhl_result"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
