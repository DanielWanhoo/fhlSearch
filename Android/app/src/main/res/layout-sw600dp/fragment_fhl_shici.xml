<?xml version="1.0" encoding="utf-8"?>
<!-- 诗词检索（平板双栏）：左＝字格与按键，右＝命中诗句列表 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:paddingStart="@dimen/fhl_screen_pad"
    android:paddingEnd="@dimen/fhl_screen_pad"
    android:paddingTop="@dimen/fhl_gap_s"
    android:paddingBottom="@dimen/fhl_gap_s">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="44"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                android:id="@+id/header"
                layout="@layout/view_fhl_header" />

            <include
                android:id="@+id/cond"
                layout="@layout/view_fhl_shici_cond" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="@dimen/fhl_stroke_hair"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/fhl_pane_gap"
        android:layout_marginEnd="@dimen/fhl_pane_gap"
        android:background="@color/fhl_line" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="56"
        android:orientation="vertical">

        <include
            android:id="@+id/actions"
            layout="@layout/view_fhl_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/fhl_gap_s" />

        <include
            android:id="@+id/result"
            layout="@layout/view_fhl_result"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
