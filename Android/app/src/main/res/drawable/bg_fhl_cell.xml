<?xml version="1.0" encoding="utf-8"?>
<!-- 诗词字格：未选中＝宣纸面 + 细金边；选中＝朱砂粗框（需求：红色方框标亮） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/fhl_vermilion_tint" />
            <corners android:radius="@dimen/fhl_radius_s" />
            <stroke android:width="@dimen/fhl_stroke_focus" android:color="@color/fhl_vermilion_light" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/fhl_card_soft" />
            <corners android:radius="@dimen/fhl_radius_s" />
            <stroke android:width="@dimen/fhl_stroke_focus" android:color="@color/fhl_vermilion_light" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/fhl_card_soft" />
            <corners android:radius="@dimen/fhl_radius_s" />
            <stroke android:width="@dimen/fhl_stroke_hair" android:color="@color/fhl_line" />
        </shape>
    </item>
</selector>
