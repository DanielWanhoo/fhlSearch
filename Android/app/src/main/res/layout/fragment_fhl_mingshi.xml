<?xml version="1.0" encoding="utf-8"?>
<!-- 名士检索（手机，图二样式）：整页翻页 + 常驻操作区
     固定：标题 / 已检索汇总 / 按钮行（清空所有·清空当前·二次检索）/ 底部检索键
     滚动：九种条件 + 匹配结果 + 结果卡片
     这样检索后结果自动滚进视野时，操作按钮始终在手边。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/fhl_screen_pad"
    android:paddingEnd="@dimen/fhl_screen_pad">

    <include
        android:id="@+id/header"
        layout="@layout/view_fhl_header" />

    <TextView
        android:id="@+id/tvApplied"
        style="@style/TextFhlCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/fhl_ink_sub"
        android:visibility="gone"
        tools:text="已检索：朝代：先秦"
        tools:visibility="visible" />

    <include
        android:id="@+id/actions"
        layout="@layout/view_fhl_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fhl_gap_s" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/fhl_gap_s"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                android:id="@+id/modes"
                layout="@layout/view_fhl_ms_modes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/result"
                layout="@layout/view_fhl_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fhl_gap_m" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSearch"
        style="@style/BtnFhlPrimary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fhl_btn_h"
        android:layout_marginTop="@dimen/fhl_gap_s"
        android:layout_marginBottom="@dimen/fhl_gap_s"
        android:text="@string/ms_search" />
</LinearLayout>
