<?xml version="1.0" encoding="utf-8"?>
<!-- 成语检索（手机单栏）：上＝检索条件（可滚动），下＝检索结果（填充剩余空间） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/fhl_screen_pad"
    android:paddingEnd="@dimen/fhl_screen_pad">

    <!-- 条件区按内容高度收缩（不要再按权重撑满），
         否则内容只有约 260dp 时会在条件区底部留出一大片空白，
         把结果区白白挤小。改成 wrap_content 后，多出来的空间全部给结果区。 -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                android:id="@+id/header"
                layout="@layout/view_fhl_header" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_fhl_card"
                android:orientation="vertical"
                android:padding="@dimen/fhl_gap_s">

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_fhl_card_soft"
                    app:tabGravity="fill"
                    app:tabIndicatorColor="@color/fhl_vermilion"
                    app:tabIndicatorFullWidth="false"
                    app:tabIndicatorHeight="3dp"
                    app:tabMode="fixed"
                    app:tabRippleColor="@color/fhl_gold_tint"
                    app:tabSelectedTextColor="@color/fhl_vermilion"
                    app:tabTextColor="@color/fhl_ink_sub" />

                <LinearLayout
                    android:id="@+id/layInputs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/fhl_gap_s"
                    android:baselineAligned="false"
                    android:orientation="horizontal" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSearch"
                style="@style/BtnFhlPrimary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/fhl_btn_h"
                android:layout_marginTop="@dimen/fhl_gap_m"
                android:text="@string/cy_search" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 结果区：按钮行（清空所有 / 清空当前 / 二次检索）在结果标题上方，与图一一致 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/fhl_gap_m"
        android:layout_weight="1"
        android:orientation="vertical">

        <include
            android:id="@+id/actions"
            layout="@layout/view_fhl_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/fhl_gap_s" />

        <include
            android:id="@+id/result"
            layout="@layout/view_fhl_result"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
