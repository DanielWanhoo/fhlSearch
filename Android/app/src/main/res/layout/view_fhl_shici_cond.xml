<?xml version="1.0" encoding="utf-8"?>
<!-- 诗词检索的条件区（字格 + 清空/开始检索）：手机与平板共用。
     刻意不用 <merge> 作根：<merge> 被 include 时 id 不会传给子控件，运行时找不到 id 会崩溃。
     注：原来这里还有一块"虚拟方向键"面板，已按需求删除；
         接外接物理键盘时仍然可以用 ↑ ↓ ← → 移动选中格（由 ShiciGrid 直接处理按键）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cond"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_fhl_card"
        android:orientation="vertical"
        android:padding="@dimen/fhl_gap_s">

        <com.wangchuan.fhlsearch.widget.ShiciGrid
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fhl_gap_m"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClear"
            style="@style/BtnFhlLight"
            android:layout_width="0dp"
            android:layout_height="@dimen/fhl_btn_h"
            android:layout_marginEnd="@dimen/fhl_gap_s"
            android:layout_weight="1"
            android:text="@string/sc_clear" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSearch"
            style="@style/BtnFhlPrimary"
            android:layout_width="0dp"
            android:layout_height="@dimen/fhl_btn_h"
            android:layout_weight="1.6"
            android:text="@string/sc_search" />
    </LinearLayout>
</LinearLayout>
