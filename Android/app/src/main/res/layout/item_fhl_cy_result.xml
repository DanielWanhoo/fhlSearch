<?xml version="1.0" encoding="utf-8"?>
<!-- 成语结果卡片（图一样式）：三行 —— 成语 / 带调拼音 / 声调：数字 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/fhl_gap_m"
    android:background="@drawable/bg_fhl_cy_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/fhl_gap_m"
    android:paddingEnd="@dimen/fhl_gap_m"
    android:paddingTop="@dimen/fhl_gap_m"
    android:paddingBottom="@dimen/fhl_gap_m">

    <TextView
        android:id="@+id/tvCyWord"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/fhl_ink"
        android:textSize="22sp"
        android:textStyle="bold"
        tools:text="伪游云梦" />

    <TextView
        android:id="@+id/tvCyPinyin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fhl_gap_xs"
        android:letterSpacing="0.02"
        android:textColor="@color/fhl_vermilion"
        android:textSize="@dimen/fhl_fs_body"
        tools:text="wěi yóu yún mèng" />

    <TextView
        android:id="@+id/tvCyTone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/fhl_ink_sub"
        android:textSize="@dimen/fhl_fs_body_s"
        tools:text="声调：3 2 2 4" />
</LinearLayout>
