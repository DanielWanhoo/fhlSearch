<?xml version="1.0" encoding="utf-8"?>
<!-- 成语结果卡片（v3.2）：三行逐字对齐、靠左
     每列一个成语字，竖着排：声调（小圆角标） / 拼音 / 单字，四列等宽。
     单列内容由 item_fhl_cy_col.xml 在 ResultView 里生成 4 份。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/fhl_gap_m"
    android:background="@drawable/bg_fhl_cy_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/fhl_gap_m"
    android:paddingEnd="@dimen/fhl_gap_m"
    android:paddingTop="@dimen/fhl_gap_m"
    android:paddingBottom="@dimen/fhl_gap_m">

    <LinearLayout
        android:id="@+id/layCols"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal" />
</LinearLayout>
