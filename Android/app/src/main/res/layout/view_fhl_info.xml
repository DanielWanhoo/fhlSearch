<?xml version="1.0" encoding="utf-8"?>
<!-- 信息弹窗：软件信息 + 使用方法（点大标题右边的「i」打开）
     内容较长，滚动区高度在代码里按屏幕高度封顶，避免把整屏盖满。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_fhl_sheet"
    android:orientation="vertical"
    android:padding="@dimen/fhl_gap_l">

    <TextView
        android:id="@+id/tvInfoCaption"
        style="@style/TextFhlCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/info_caption" />

    <TextView
        android:id="@+id/tvInfoTitle"
        style="@style/TextFhlTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fhl_gap_xs"
        android:text="@string/info_title" />

    <TextView
        android:id="@+id/tvInfoVersion"
        style="@style/TextFhlCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fhl_gap_xs"
        tools:text="版本 3.0 ｜ Android 10 及以上 ｜ 完全离线" />

    <TextView
        android:id="@+id/tvInfoStats"
        style="@style/TextFhlCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        tools:text="题库：成语 319 条 · 诗词 282 条 · 名士 115 位" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/fhl_stroke_hair"
        android:layout_marginTop="@dimen/fhl_gap_m"
        android:background="@color/fhl_line" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fhl_gap_s">

        <TextView
            android:id="@+id/tvInfoBody"
            style="@style/TextFhlBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="6dp"
            android:text="@string/info_body" />
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnInfoClose"
        style="@style/BtnFhlPrimary"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="@dimen/fhl_gap_m"
        android:text="@string/info_close" />
</LinearLayout>
